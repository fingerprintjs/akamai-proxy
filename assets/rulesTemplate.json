      "behaviors": [
        {
          "name": "modifyIncomingRequestHeader",
          "options": {
            "action": "MODIFY",
            "standardModifyHeaderName": "OTHER",
            "newHeaderValue": "{{user.PMUSER_FPJS_PROXY_SECRET}}",
            "avoidDuplicateHeaders": true,
            "customHeaderName": "FPJS-Proxy-Secret"
